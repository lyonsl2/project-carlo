{
  "name": "project-carlo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "fetch": "uv run python -m pdf_extract fetch",
    "process": "uv run python -m pdf_extract process",
    "sync": "uv run python -m pdf_extract sync",
    "detect": "uv run python -m pdf_extract detect",
    "geocode": "uv run python -m pdf_extract geocode",
    "seed": "uv run python -m pdf_extract seed",
    "db:migrate": "uv run python -m pdf_extract db migrate",
    "db:drop": "uv run python -m pdf_extract db drop",
    "db:downgrade": "uv run python -m pdf_extract db downgrade",
    "install:web": "pnpm --dir apps/web install",
    "dev:web": "pnpm --dir apps/web dev",
    "extract:web": "uv run python apps/web/scripts/extract_frontend_db.py",
    "build:web": "pnpm --dir apps/web build",
    "preview:web": "pnpm --dir apps/web preview",
    "lint:web": "pnpm --dir apps/web lint",
    "check:web": "pnpm --dir apps/web check"
  }
}
