# Web app environment variables.
#
# Vite only exposes variables prefixed with VITE_ to the browser, and inlines
# them at build time, so everything here is public. Never put a Stripe secret
# key or a Supabase service role key in this file.
#
# For local development copy the values you need into
# apps/web/.env.development.local, which is gitignored. For production set them
# wherever the build runs (GitHub Actions secrets, then passed through to
# `pnpm build:web`).

# --- Accounts and billing -------------------------------------------------
# Leave both unset to build the site exactly as it was before accounts existed:
# no sign-in, no account routes, and no Supabase client in the bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable/anon key. Safe to ship; row level security is what protects
# the data behind it.
VITE_SUPABASE_ANON_KEY=

# Adds a "Continue with Google" button. Only turn this on once the Google
# provider is configured in the Supabase dashboard.
VITE_AUTH_GOOGLE_ENABLED=false

# --- Existing features ----------------------------------------------------
VITE_GEOAPIFY_API_KEY=
VITE_TALLY_FORM_ID=
VITE_ABOUT_PAGE_ENABLED=false
