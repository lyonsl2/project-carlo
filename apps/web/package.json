{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:ts && pnpm run build:vite && pnpm run build:prerender",
    "build:ts": "tsc -b",
    "build:vite": "vite build",
    "build:prerender": "tsx --tsconfig tsconfig.app.json scripts/prerender.ts",
    "preview": "pnpm run build && wrangler dev",
    "lint": "eslint .",
    "check": "tsc -b",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.2.7",
    "@fontsource/cardo": "^5.2.8",
    "@tanstack/react-query": "^5.90.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.4",
    "shadcn": "^4.2.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.11",
    "vitest": "^4.1.8",
    "wrangler": "^4.71.0"
  }
}
