# Secrets for the edge functions.
#
# Local:  copy to supabase/functions/.env and run
#           supabase functions serve --env-file supabase/functions/.env
# Hosted: supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected
# into deployed functions automatically and must not be set here.

# Stripe secret key. Use the test key (sk_test_...) until you are ready to
# charge real cards.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the webhook endpoint. The dashboard endpoint and
# `stripe listen` each have their own; they are not interchangeable.
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...

# Recurring prices for the two plan keys the client can ask for. Anything not
# listed here cannot be purchased.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# Absolute base URL that Stripe returns the browser to. Return paths from the
# client are resolved against this and must be same-site.
SITE_URL=http://127.0.0.1:5173

# Origins allowed to call the functions from a browser, comma separated.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
